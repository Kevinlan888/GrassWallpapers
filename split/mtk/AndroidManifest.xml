<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.a65.grasswallpapers.mtk"
    android:versionCode="4"
    android:versionName="1.3">

    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="35" />

    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/split_mtk_app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.A65Grass">

        <activity
            android:name="com.a65.grasswallpapers.SingleWallpaperActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="com.a65.grasswallpapers.SINGLE_WALLPAPER_SERVICE"
                android:value="com.a65.grasswallpapers.wallpaper.MtkGrassWallpaperService" />
        </activity>

        <service
            android:name="com.a65.grasswallpapers.wallpaper.MtkGrassWallpaperService"
            android:exported="true"
            android:label="@string/mtk_wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/mtk_grass_wallpaper" />
        </service>
    </application>

</manifest>
